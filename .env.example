# Family Settings
# Your family name displayed throughout the app
FAMILY_NAME=My Family

# Timezone for event display and scheduling
# Find yours at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York

# Security
# Generate with: openssl rand -hex 32
# IMPORTANT: Back this up in a password manager - losing it means re-connecting all calendar sources
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX

# Database
# Default uses local SQLite database in the data directory
DATABASE_URL=sqlite+aiosqlite:////data/db/homehub.db

# CORS - Allowed origins for API access
ALLOWED_ORIGINS=https://homehub.local

# Backup Settings
# Number of days to retain backup files
BACKUP_RETENTION_DAYS=30

# Time of day to run daily backup (24-hour format HH:MM)
BACKUP_TIME=03:00

# Wall Display Settings
# Seconds of inactivity before wall display dims/screensaver
WALL_IDLE_TIMEOUT_SECONDS=300
